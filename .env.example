# Copy to .env and fill in real values. Do NOT commit the real .env.

# Required. Your paid xAI API key (billing credential). Keep it secret.
XAI_API_KEY=xai-your-key-here

# Required. Shared secret MCP clients send as "Authorization: Bearer <token>".
# Use a long random value, e.g. `openssl rand -hex 32` (64 hex chars).
BRIDGE_TOKEN=replace-with-a-long-random-string

# Optional. xAI model name to call. Defaults to grok-4.3.
GROK_MODEL=grok-4.3

# Optional. Port the server binds to (0.0.0.0:$PORT). Defaults to 8000.
PORT=8000

# Optional. Calendar-month USD cap for calls through this process (UTC month).
# Default 15, matching the intended xAI spend cap. Also set the same cap in
# the xAI console; this process tally can reset if the disk is wiped.
MONTHLY_BUDGET_USD=15

# Optional. Max authenticated tool calls per rolling 60 seconds. Default 30.
RATE_LIMIT_PER_MINUTE=30

# Optional. Max combined prompt+system characters. Default 16000.
MAX_PROMPT_CHARS=16000

# Optional. Upstream request timeout in seconds. Default 120.
XAI_TIMEOUT_SECONDS=120

# Optional. Where the month-to-date spend tally is stored. Default /tmp/grok-bridge-usage.json.
USAGE_FILE=/tmp/grok-bridge-usage.json

# Optional. Conservative surcharge added per ask_grok_live call (web/X search). Default 0.01.
LIVE_SEARCH_SURCHARGE_USD=0.01

# Optional. Price overrides (USD per million tokens). Defaults are grok-4.3 short-context rates.
# INPUT_USD_PER_MTOK=1.25
# OUTPUT_USD_PER_MTOK=2.50

# Optional. Two-way mailbox so Claude can message Grok Bot (the orchestrator).
# Leave unset to keep message_grok_bot disabled. Never commit real values.
# GROK_BOT_WEBHOOK_URL=https://api2.cursor.sh/automations/webhook/your-routine-id
# GROK_BOT_WEBHOOK_KEY=paste-from-the-routine-panel-never-into-chat
# MAILBOX_TOKEN=a-different-long-random-string-not-the-bridge-token
# MAILBOX_MAX_PER_HOUR=10
# MAILBOX_MAX_PER_DAY=20
# MAILBOX_MAX_CHARS=16000
# MAILBOX_WEBHOOK_TIMEOUT_SECONDS=8
# MAILBOX_MAX_WAIT_SECONDS=25
