# Copy to .env and fill in real values. Do NOT commit the real .env.

# Required. Your paid xAI API key (billing credential). Keep it secret.
XAI_API_KEY=xai-your-key-here

# Required. Shared secret MCP clients send as "Authorization: Bearer <token>".
# Use a long random value, e.g. `openssl rand -hex 32`.
BRIDGE_TOKEN=replace-with-a-long-random-string

# Optional. xAI model name to call. Defaults to grok-4.3.
GROK_MODEL=grok-4.3

# Optional. Port the server binds to (0.0.0.0:$PORT). Defaults to 8000.
PORT=8000
